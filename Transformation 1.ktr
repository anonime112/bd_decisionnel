    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Connexion_MaBase_Ecommerce</connection>
    <sql>SELECT 
    c.id_commande, 
    c.id_utilisateur,
    c.total AS total_commande,
    c.statut AS statut_commande,
    c.date_commande, 
    u.nom AS nom_client,
    u.prenom AS prenom_client,
    u.email AS email_client,
    p.nom AS produit,
    d.quantite,
    d.prix_unitaire,
    p.id_produit,
    u.id_utilisateur,
    -- Associer la date de la commande à une dimension Temps
    YEAR(c.date_commande) AS annee_commande,
    MONTH(c.date_commande) AS mois_commande,
    DAY(c.date_commande) AS jour_commande,
    -- Si tu as besoin d'informations géographiques supplémentaires :
    u.ville AS ville_client,
    u.pays AS pays_client
FROM 
    commandes c
JOIN utilisateurs u ON c.id_utilisateur = u.id_utilisateur
JOIN details_commande d ON c.id_commande = d.id_commande
JOIN produits p ON d.id_produit = p.id_produit;
</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
